{
  "source": {
    "include": [
      "src/models",
      "src/services"
    ],
    "includePattern": ".+\\.js$",
    "excludePattern": "(^|\\/|\\\\)node_modules(\\/|\\\\)"
  },
  "opts": {
    "destination": "docs/jsdoc",
    "encoding": "utf8",
    "recurse": true
  },
  "sourceType": "script",
  "tags": {
    "allowUnknownTags": false,
    "dictionaries": [
      "jsdoc"
    ]
  },
  "templates": {
    "default": {
      "includeDate": false
    }
  }
}